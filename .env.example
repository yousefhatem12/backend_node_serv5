NODE_ENV=development
APP_NAME=SkillMatch
PORT=8000
APP_URL=http://localhost:8000

# XAMPP MySQL Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skillmatch
DB_TEST_NAME=skillmatch_test

# Authentication & JWT
JWT_SECRET=skillmatch_jwt_super_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=900000
JWT_REFRESH_EXPIRES_IN=604800

# Static OTP toggle for testing/staging (allows 123456 bypass)
STATIC_OTP_ENABLED=true
STATIC_OTP_CODE=123456

# Mail configuration (SMTP / Gmail)
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@skillmatch.com
MAIL_FROM_NAME=SkillMatch

# File Storage
UPLOAD_MAX_FILE_SIZE_MB=5
STORAGE_PATH=./storage

# AI Integration Layer
AI_PROVIDER=remote
AI_CONFIDENCE_THRESHOLD=0.7
AI_SERVICE_BASE_URL=https://ai-serv5.fastapicloud.dev
AI_SERVICE_SECRET_KEY=YOUR_SECRET_KEY_HERE
AI_SERVICE_API_KEY=YOUR_SECRET_KEY_HERE
AI_SERVICE_URL=https://ai-serv5.fastapicloud.dev
AI_MATCH_SERVICE_ENABLED=true
AI_STRATEGY_SERVICE_ENABLED=true
AI_CV_IMPROVER_SERVICE_ENABLED=true
AI_INTERVIEW_COACH_ENABLED=true
AI_MENTOR_SERVICE_ENABLED=true
AI_ROADMAP_SERVICE_ENABLED=true

# Localization
DEFAULT_LOCALE=en
FALLBACK_LOCALE=en
