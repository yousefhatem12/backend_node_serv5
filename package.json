{
  "name": "skillmatch-backend-node",
  "version": "1.0.0",
  "description": "SkillMatch Career Intelligence & Job Matching Platform Backend (Node.js + Express + Sequelize)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:test": "cross-env NODE_ENV=test npx sequelize-cli db:migrate",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:mock": "node scripts/seed-mock-jobs-and-notifications.js",
    "seed:undo": "npx sequelize-cli db:seed:undo:all",
    "docs:generate": "node scripts/generate-openapi-json.js"
  },
  "keywords": [
    "skillmatch",
    "express",
    "sequelize",
    "mysql",
    "career-intelligence"
  ],
  "author": "SkillMatch Engineering",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "sequelize": "^6.37.8",
    "winston": "^3.19.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1"
  }
}
