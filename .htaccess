PassengerAppRoot /home2/iptvdemo/public_html/skillmatch-backend-node

PassengerNodejs /home2/iptvdemo/nodeapps/skillmatch-backend-node/bin/node
PassengerAppType node
PassengerStartupFile server.js

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # السماح بالوصول للملفات والمجلدات الحقيقية لو وجدت
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # إعادة توجيه مسارات yosefback بالشكل الصحيح لتمريرها لتطبيق Node.js
    RewriteRule ^yosefback/?(.*)$ /$1 [QSA,L]
</IfModule>